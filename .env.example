# Google Cloud & Gemini Enterprise (Discovery Engine) Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
GE_LOCATION=global
GE_COLLECTION_ID=default_collection
GE_ENGINE_ID=your-gemini-enterprise-engine-id
GE_ASSISTANT_ID=default_assistant
GE_WIDGET_CID=your-console-widget-cid

# Registered Gemini Enterprise Skills & Low-Code Agent IDs
GE_PRIMARY_SKILL_ID=private-enterprise-triage-skill
GE_PRIMARY_AGENT_ID=your-primary-agent-id
GE_ORCHESTRATOR_SKILL_ID=private-enterprise-orchestrator-skill
GE_ORCHESTRATOR_AGENT_ID=your-orchestrator-agent-id

# Connected Cloud Storage (GCS) DataStore Connectors
GE_DATASTORE_ID=your-gcs-datastore-id
GCS_BUCKET_NAME=your-gcs-bucket-name

# UI Customization (Optional)
UI_APP_TITLE=Enterprise Assistant
UI_APP_SUBTITLE=Gemini Enterprise streamAssist Portal
UI_PRIMARY_COLOR=#2563EB
